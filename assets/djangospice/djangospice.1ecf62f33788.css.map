
/* Base row */
[data-table-row] {
    position: relative;
    background-color: #ffffff;
    border-left: 2px solid transparent;

    transition:
        background-color 150ms ease,
        box-shadow 150ms ease,
        border-color 150ms ease;
}

/* Gmail-style hover elevation */
[data-table-row]:hover {
    z-index: 2;
    background-color: #f8fafc;
    border-left-color: #cbd5e1;

    box-shadow:
        0 1px 2px rgba(60, 64, 67, 0.15),
        0 1px 3px 1px rgba(60, 64, 67, 0.08);
}

[data-table-row]:hover > td {
    background-color: #f8fafc;
}

/* Selected row */
[data-table-row].is-selected {
    background-color: #eff6ff;
    border-left-color: #3b82f6;
}

[data-table-row].is-selected > td {
    background-color: #eff6ff;
}

/* Selected + hovered */
[data-table-row].is-selected:hover {
    background-color: #dbeafe;

    box-shadow:
        0 1px 3px rgba(60, 64, 67, 0.18),
        0 2px 5px rgba(60, 64, 67, 0.10);
}

[data-table-row].is-selected:hover > td {
    background-color: #dbeafe;
}

/* Smooth cell transitions */
[data-table-row] > td {
    transition: background-color 150ms ease;
}
