/**
 * SpiceRouter
 *
 * Framework-agnostic navigation layer built on HTMX.
 *
 * Public elements:
 *   <spice-app>
 *   <spice-link>
 *   <spice-button>
 *   <spice-nav>
 *   <spice-boost>
 *   <spice-loading>
 *
 * HTMX owns:
 *   - HTTP requests
 *   - DOM swapping
 *   - Browser history
 *
 * SpiceRouter owns:
 *   - Navigation configuration
 *   - Custom navigation elements
 *   - Active navigation links
 *   - Loading indicators
 *   - Navigation lifecycle events
 *   - Dynamic navigation enhancement
 */

const DEFAULTS = {
    target: "#spice-app",
    select: "#spice-app",
    swap: "innerHTML show:window:top",
    transition: false,
    preload: false,
    pushUrl: true,
};

const HTTP_METHODS = new Set([
    "get",
    "post",
    "put",
    "patch",
    "delete",
]);

const RESERVED_ATTRIBUTES = new Set([
    "to",
    "method",
    "exact",
    "active-class",
    "transition",
    "preload",
    "push-url",
    "select",
    "swap",
]);

const ROUTER_EVENTS = {
    READY: "spice:router:ready",
    BEFORE_NAVIGATE: "spice:router:before-navigate",
    BEFORE_SWAP: "spice:router:before-swap",
    AFTER_SWAP: "spice:router:after-swap",
    NAVIGATE: "spice:router:navigate",
    LOCATION_CHANGE: "spice:router:location-change",
    NAVIGATION_ERROR: "spice:router:navigation-error",
    LOADING: "spice:router:loading",
    LOADED: "spice:router:loaded",
};


/* -------------------------------------------------------------------------- */
/* Utilities                                                                  */
/* -------------------------------------------------------------------------- */

function emit(target, name, detail = {}, options = {}) {
    const element = target || document;

    return element.dispatchEvent(
        new CustomEvent(name, {
            bubbles: true,
            composed: true,
            cancelable: options.cancelable ?? false,
            detail,
        })
    );
}


function parseBoolean(value, fallback = false) {
    if (value === null || value === undefined) {
        return fallback;
    }

    if (value === "") {
        return true;
    }

    return !["false", "0", "off", "no"].includes(
        String(value).toLowerCase()
    );
}


function normalizePath(path) {
    if (!path) return "/";

    let normalized = path.replace(/\/+/g, "/");

    if (normalized.length > 1) {
        normalized = normalized.replace(/\/$/, "");
    }

    return normalized || "/";
}


function isInternalURL(value) {
    if (!value) return false;

    try {
        const url = new URL(value, window.location.href);

        return (
            ["http:", "https:"].includes(url.protocol) &&
            url.origin === window.location.origin
        );
    } catch {
        return false;
    }
}


function isFragmentOnly(value) {
    return typeof value === "string" && value.startsWith("#");
}


function isSamePageFragment(value) {
    try {
        const url = new URL(value, window.location.href);

        return (
            url.origin === window.location.origin &&
            url.pathname === window.location.pathname &&
            url.search === window.location.search &&
            Boolean(url.hash)
        );
    } catch {
        return false;
    }
}


function shouldEnhanceAnchor(anchor) {
    if (!anchor || !anchor.hasAttribute("href")) {
        return false;
    }

    const href = anchor.getAttribute("href");

    if (!href || isFragmentOnly(href) || isSamePageFragment(href)) {
        return false;
    }

    if (!isInternalURL(anchor.href)) {
        return false;
    }

    if (
        anchor.hasAttribute("download") ||
        anchor.target === "_blank" ||
        anchor.relList.contains("external") ||
        anchor.getAttribute("hx-boost") === "false"
    ) {
        return false;
    }

    return true;
}


function copyAttributes(source, destination, excluded = new Set()) {
    for (const attribute of source.attributes) {
        const name = attribute.name;

        if (
            RESERVED_ATTRIBUTES.has(name) ||
            excluded.has(name) ||
            name.startsWith("data-spice-internal-")
        ) {
            continue;
        }

        destination.setAttribute(name, attribute.value);
    }
}


/* -------------------------------------------------------------------------- */
/* SpiceRouter                                                                */
/* -------------------------------------------------------------------------- */

export class SpiceRouter {
    constructor(options = {}) {
        this.options = {
            ...DEFAULTS,
            ...options,
        };

        this.started = false;

        this.apps = new Set();
        this.processedContainers = new WeakSet();
        this.observer = null;

        this.boundHandlers = {
            beforeRequest: this.handleBeforeRequest.bind(this),
            beforeSwap: this.handleBeforeSwap.bind(this),
            afterSwap: this.handleAfterSwap.bind(this),
            afterRequest: this.handleAfterRequest.bind(this),
            pushedIntoHistory: this.handlePushedIntoHistory.bind(this),
            responseError: this.handleRequestError.bind(this),
            sendError: this.handleRequestError.bind(this),
            timeout: this.handleRequestError.bind(this),
            sendAbort: this.handleRequestError.bind(this),
            popstate: this.handlePopState.bind(this),
        };
    }


    /* ---------------------------------------------------------------------- */
    /* Lifecycle                                                              */
    /* ---------------------------------------------------------------------- */

    start() {
        if (this.started) return this;

        if (!window.htmx) {
            throw new Error(
                "SpiceRouter requires HTMX. Load HTMX before starting SpiceRouter."
            );
        }

        this.registerElements();
        this.initListeners();
        this.initBoostContainers();
        this.refreshActiveLinks();
        this.observeDOM();

        this.started = true;

        emit(document, ROUTER_EVENTS.READY, {
            router: this,
        });

        return this;
    }


    stop() {
        if (!this.started) return this;

        const events = {
            "htmx:beforeRequest": "beforeRequest",
            "htmx:beforeSwap": "beforeSwap",
            "htmx:afterSwap": "afterSwap",
            "htmx:afterRequest": "afterRequest",
            "htmx:pushedIntoHistory": "pushedIntoHistory",
            "htmx:responseError": "responseError",
            "htmx:sendError": "sendError",
            "htmx:timeout": "timeout",
            "htmx:sendAbort": "sendAbort",
        };

        for (const [eventName, handlerName] of Object.entries(events)) {
            document.removeEventListener(
                eventName,
                this.boundHandlers[handlerName]
            );
        }

        window.removeEventListener(
            "popstate",
            this.boundHandlers.popstate
        );

        this.observer?.disconnect();
        this.observer = null;

        this.started = false;

        return this;
    }


    updateOptions(options = {}) {
        this.options = {
            ...this.options,
            ...options,
        };

        if (this.started) {
            this.initBoostContainers();
            this.refreshActiveLinks();
        }

        return this;
    }


    /* ---------------------------------------------------------------------- */
    /* Custom elements                                                        */
    /* ---------------------------------------------------------------------- */

    registerElements() {
        const router = this;

        if (!customElements.get("spice-app")) {
            customElements.define(
                "spice-app",
                class extends HTMLElement {
                    connectedCallback() {
                        if (!this.id) {
                            this.id = "spice-app";
                        }

                        router.apps.add(this);
                        router.processBoostContainer(this);
                    }

                    disconnectedCallback() {
                        router.apps.delete(this);
                    }
                }
            );
        }


        if (!customElements.get("spice-link")) {
            customElements.define(
                "spice-link",
                class extends HTMLElement {
                    connectedCallback() {
                        if (this.dataset.spiceInitialized) return;

                        this.dataset.spiceInitialized = "true";

                        const destination = this.getAttribute("to");

                        if (!destination) {
                            console.warn(
                                "<spice-link> requires a 'to' attribute."
                            );
                            return;
                        }

                        const anchor = document.createElement("a");

                        copyAttributes(this, anchor, new Set([
                            "data-spice-initialized",
                        ]));

                        anchor.href = destination;
                        anchor.dataset.spiceLink = "true";

                        if (this.hasAttribute("exact")) {
                            anchor.dataset.spiceExact = "true";
                        }

                        if (this.hasAttribute("active-class")) {
                            anchor.dataset.spiceActiveClass =
                                this.getAttribute("active-class");
                        }

                        if (this.hasAttribute("match-query")) {
                            anchor.dataset.spiceMatchQuery = "true";
                        }

                        anchor.append(...this.childNodes);

                        if (shouldEnhanceAnchor(anchor)) {
                            router.initializeRequest(anchor, {
                                to: destination,
                                method: "get",
                                pushUrl: true,
                            });
                        }

                        this.replaceWith(anchor);
                        router.refreshActiveLinks();
                    }
                }
            );
        }


        if (!customElements.get("spice-button")) {
            customElements.define(
                "spice-button",
                class extends HTMLElement {
                    connectedCallback() {
                        if (this.dataset.spiceInitialized) return;

                        this.dataset.spiceInitialized = "true";

                        const destination = this.getAttribute("to");
                        const method = (
                            this.getAttribute("method") || "post"
                        ).toLowerCase();

                        if (!destination) {
                            console.warn(
                                "<spice-button> requires a 'to' attribute."
                            );
                            return;
                        }

                        if (!HTTP_METHODS.has(method)) {
                            console.error(
                                `Unsupported SpiceRouter method: ${method}`
                            );
                            return;
                        }

                        const button = document.createElement("button");

                        copyAttributes(this, button, new Set([
                            "data-spice-initialized",
                        ]));

                        button.type = this.getAttribute("type") || "button";
                        button.append(...this.childNodes);

                        router.initializeRequest(button, {
                            to: destination,
                            method,
                            pushUrl: parseBoolean(
                                this.getAttribute("push-url"),
                                false
                            ),
                        });

                        this.replaceWith(button);
                    }
                }
            );
        }


        if (!customElements.get("spice-nav")) {
            customElements.define(
                "spice-nav",
                class extends HTMLElement {
                    connectedCallback() {
                        router.processBoostContainer(this);
                    }
                }
            );
        }


        if (!customElements.get("spice-boost")) {
            customElements.define(
                "spice-boost",
                class extends HTMLElement {
                    connectedCallback() {
                        router.processBoostContainer(this);
                    }
                }
            );
        }


        if (!customElements.get("spice-loading")) {
            customElements.define(
                "spice-loading",
                class extends HTMLElement {
                    constructor() {
                        super();

                        this.requests = new Set();
                        this.fallbackRequestCount = 0;

                        this.onBeforeRequest =
                            this.handleBeforeRequest.bind(this);

                        this.onAfterRequest =
                            this.handleAfterRequest.bind(this);

                        this.onRequestError =
                            this.handleRequestError.bind(this);
                    }


                    connectedCallback() {
                        this.hidden = true;

                        document.addEventListener(
                            "htmx:beforeRequest",
                            this.onBeforeRequest
                        );

                        document.addEventListener(
                            "htmx:afterRequest",
                            this.onAfterRequest
                        );

                        [
                            "htmx:sendError",
                            "htmx:timeout",
                            "htmx:sendAbort",
                        ].forEach(eventName => {
                            document.addEventListener(
                                eventName,
                                this.onRequestError
                            );
                        });
                    }


                    disconnectedCallback() {
                        document.removeEventListener(
                            "htmx:beforeRequest",
                            this.onBeforeRequest
                        );

                        document.removeEventListener(
                            "htmx:afterRequest",
                            this.onAfterRequest
                        );

                        [
                            "htmx:sendError",
                            "htmx:timeout",
                            "htmx:sendAbort",
                        ].forEach(eventName => {
                            document.removeEventListener(
                                eventName,
                                this.onRequestError
                            );
                        });
                    }


                    matchesRequest(detail) {
                        const trigger =
                            detail?.elt ||
                            detail?.requestConfig?.elt;

                        const actualTarget = detail?.target;

                        const selector = this.getAttribute("target");
                        const scope = this.getAttribute("scope");

                        if (scope && trigger) {
                            const scopeElement = trigger.closest(scope);

                            if (!scopeElement) return false;
                        }

                        if (!selector) {
                            return true;
                        }

                        if (actualTarget) {
                            try {
                                return actualTarget.matches(selector);
                            } catch {
                                return false;
                            }
                        }

                        return false;
                    }


                    getRequestKey(detail) {
                        return (
                            detail?.xhr ||
                            detail?.requestConfig?.xhr ||
                            null
                        );
                    }


                    handleBeforeRequest(event) {
                        const detail = event.detail || {};

                        if (!this.matchesRequest(detail)) return;

                        const key = this.getRequestKey(detail);

                        if (key) {
                            this.requests.add(key);
                        } else {
                            this.fallbackRequestCount++;
                        }

                        this.show();
                    }


                    handleAfterRequest(event) {
                        const detail = event.detail || {};

                        if (!this.matchesRequest(detail)) return;

                        this.finishRequest(detail);
                    }


                    handleRequestError(event) {
                        const detail = event.detail || {};

                        if (!this.matchesRequest(detail)) return;

                        this.finishRequest(detail);
                    }


                    finishRequest(detail) {
                        const key = this.getRequestKey(detail);

                        if (key) {
                            this.requests.delete(key);
                        } else if (this.fallbackRequestCount > 0) {
                            this.fallbackRequestCount--;
                        }

                        if (
                            this.requests.size === 0 &&
                            this.fallbackRequestCount === 0
                        ) {
                            this.hide();
                        }
                    }


                    show() {
                        if (!this.hidden) return;

                        this.hidden = false;

                        emit(this, ROUTER_EVENTS.LOADING, {
                            element: this,
                        });
                    }


                    hide() {
                        if (this.hidden) return;

                        this.hidden = true;

                        emit(this, ROUTER_EVENTS.LOADED, {
                            element: this,
                        });
                    }
                }
            );
        }
    }


    /* ---------------------------------------------------------------------- */
    /* Configuration                                                          */
    /* ---------------------------------------------------------------------- */

    resolveConfig(element) {
        const config = {
            ...this.options,
        };

        const containers = [];

        let current = element;

        while (current && current !== document.documentElement) {
            if (
                current.matches?.(
                    "spice-app, spice-nav, spice-boost, [spice-boost]"
                )
            ) {
                containers.push(current);
            }

            current = current.parentElement;
        }

        containers.reverse();

        const apply = (source, isRequestElement = false) => {
            if (!source?.getAttribute) return;

            const targetAttribute = isRequestElement
                ? "hx-target"
                : "target";

            const select = source.getAttribute("select");
            const swap = source.getAttribute("swap");
            const target = source.getAttribute(targetAttribute);
            const transition = source.getAttribute("transition");
            const preload = source.getAttribute("preload");
            const pushUrl = source.getAttribute("push-url");

            if (target !== null) config.target = target;
            if (select !== null) config.select = select;
            if (swap !== null) config.swap = swap;

            if (transition !== null) {
                config.transition = parseBoolean(
                    transition,
                    config.transition
                );
            }

            if (preload !== null) {
                config.preload = parseBoolean(
                    preload,
                    config.preload
                );
            }

            if (pushUrl !== null) {
                config.pushUrl = parseBoolean(
                    pushUrl,
                    config.pushUrl
                );
            }
        };

        containers.forEach(container => apply(container));
        apply(element, true);

        return config;
    }


    /* ---------------------------------------------------------------------- */
    /* Request initialization                                                 */
    /* ---------------------------------------------------------------------- */

    initializeRequest(
        element,
        {
            to,
            method = "get",
            pushUrl,
        } = {}
    ) {
        if (!element || !to) return false;

        method = method.toLowerCase();

        if (!HTTP_METHODS.has(method)) {
            console.error(`Unsupported HTTP method: ${method}`);
            return false;
        }

        if (!isInternalURL(to)) {
            return false;
        }

        const config = this.resolveConfig(element);

        const effectivePushUrl =
            pushUrl ?? (method === "get" && config.pushUrl);

        element.setAttribute(`hx-${method}`, to);

        if (config.target) {
            element.setAttribute("hx-target", config.target);
        }

        if (config.select) {
            element.setAttribute("hx-select", config.select);
        }

        if (config.swap) {
            const swap = config.transition
                ? `${config.swap} transition:true`
                : config.swap;

            element.setAttribute("hx-swap", swap);
        }

        element.setAttribute(
            "hx-push-url",
            effectivePushUrl ? "true" : "false"
        );

        element.dataset.spiceNavigation = "true";

        if (config.preload && this.hasPreloadExtension()) {
            element.setAttribute("preload", "mouseover");
        }

        window.htmx.process(element);

        return true;
    }


    hasPreloadExtension() {
        const htmx = window.htmx;

        return Boolean(
            htmx?.extensions?.preload ||
            htmx?.config?.extensions?.includes?.("preload")
        );
    }


    /* ---------------------------------------------------------------------- */
    /* Boost containers                                                       */
    /* ---------------------------------------------------------------------- */

    processBoostContainer(container) {
        if (!container || !window.htmx) return;

        const config = this.resolveConfig(container);

        container.setAttribute("hx-boost", "true");
        container.dataset.spiceNavigationContainer = "true";

        if (config.target) {
            container.setAttribute("hx-target", config.target);
        }

        if (config.select) {
            container.setAttribute("hx-select", config.select);
        }

        if (config.swap) {
            const swap = config.transition
                ? `${config.swap} transition:true`
                : config.swap;

            container.setAttribute("hx-swap", swap);
        }

        this.enhanceAnchors(container);

        if (!this.processedContainers.has(container)) {
            this.processedContainers.add(container);
            window.htmx.process(container);
        }
    }


    enhanceAnchors(container) {
        const anchors = container.querySelectorAll("a[href]");

        anchors.forEach(anchor => {
            if (!shouldEnhanceAnchor(anchor)) return;

            anchor.dataset.spiceNavigation = "true";
            anchor.dataset.spiceLink = "true";

            const config = this.resolveConfig(anchor);

            if (config.preload && this.hasPreloadExtension()) {
                anchor.setAttribute("preload", "mouseover");
            }
        });
    }


    initBoostContainers(root = document) {
        root.querySelectorAll(
            "spice-app, spice-nav, spice-boost, [spice-boost]"
        ).forEach(container => {
            this.processBoostContainer(container);
        });
    }


    /* ---------------------------------------------------------------------- */
    /* Active links                                                           */
    /* ---------------------------------------------------------------------- */

    refreshActiveLinks() {
        const currentURL = new URL(window.location.href);
        const currentPath = normalizePath(currentURL.pathname);

        document.querySelectorAll(
            "a[data-spice-link]"
        ).forEach(anchor => {
            let active = false;

            try {
                const linkURL = new URL(
                    anchor.href,
                    window.location.href
                );

                const linkPath = normalizePath(linkURL.pathname);

                const exact = anchor.dataset.spiceExact === "true";
                const matchQuery =
                    anchor.dataset.spiceMatchQuery === "true";

                if (exact) {
                    active = linkPath === currentPath;
                } else {
                    active =
                        linkPath === "/" ||
                        currentPath === linkPath ||
                        currentPath.startsWith(`${linkPath}/`);
                }

                if (
                    active &&
                    matchQuery &&
                    linkURL.search !== currentURL.search
                ) {
                    active = false;
                }
            } catch {
                active = false;
            }

            const activeClass =
                anchor.dataset.spiceActiveClass || "active";

            anchor.classList.toggle(activeClass, active);

            if (active) {
                anchor.setAttribute("aria-current", "page");
            } else {
                anchor.removeAttribute("aria-current");
            }
        });
    }


    /* ---------------------------------------------------------------------- */
    /* HTMX event listeners                                                   */
    /* ---------------------------------------------------------------------- */

    initListeners() {
        const events = {
            "htmx:beforeRequest": "beforeRequest",
            "htmx:beforeSwap": "beforeSwap",
            "htmx:afterSwap": "afterSwap",
            "htmx:afterRequest": "afterRequest",
            "htmx:pushedIntoHistory": "pushedIntoHistory",
            "htmx:responseError": "responseError",
            "htmx:sendError": "sendError",
            "htmx:timeout": "timeout",
            "htmx:sendAbort": "sendAbort",
        };

        for (const [eventName, handlerName] of Object.entries(events)) {
            document.addEventListener(
                eventName,
                this.boundHandlers[handlerName]
            );
        }

        window.addEventListener(
            "popstate",
            this.boundHandlers.popstate
        );
    }


    getTriggerElement(detail) {
        return (
            detail?.requestConfig?.elt ||
            detail?.elt ||
            null
        );
    }


    isRouterRequest(detail) {
        const element = this.getTriggerElement(detail);

        return Boolean(
            element?.matches?.("[data-spice-navigation]")
        );
    }


    handleBeforeRequest(event) {
        const detail = event.detail || {};

        if (!this.isRouterRequest(detail)) return;

        const element = this.getTriggerElement(detail);

        const beforeEvent = emit(
            element,
            ROUTER_EVENTS.BEFORE_NAVIGATE,
            {
                element,
                target: detail.target,
                xhr: detail.xhr,
                requestConfig: detail.requestConfig,
            },
            {
                cancelable: true,
            }
        );

        if (beforeEvent.defaultPrevented) {
            event.preventDefault();
        }
    }


    handleBeforeSwap(event) {
        const detail = event.detail || {};

        if (!this.isRouterRequest(detail)) return;

        const element = this.getTriggerElement(detail);

        const beforeEvent = emit(
            element,
            ROUTER_EVENTS.BEFORE_SWAP,
            {
                element,
                target: detail.target,
                xhr: detail.xhr,
                requestConfig: detail.requestConfig,
            },
            {
                cancelable: true,
            }
        );

        if (beforeEvent.defaultPrevented) {
            event.preventDefault();
        }
    }


    handleAfterSwap(event) {
        const detail = event.detail || {};

        if (!this.isRouterRequest(detail)) return;

        const element = this.getTriggerElement(detail);
        const target = detail.target || event.target;

        emit(target, ROUTER_EVENTS.AFTER_SWAP, {
            element,
            target,
            xhr: detail.xhr,
        });

        emit(target, ROUTER_EVENTS.NAVIGATE, {
            element,
            target,
            url: window.location.href,
            xhr: detail.xhr,
        });

        this.refreshActiveLinks();
    }


    handleAfterRequest(event) {
        const detail = event.detail || {};

        if (!this.isRouterRequest(detail)) return;

        if (detail.failed) {
            this.emitNavigationError(detail);
        }
    }


    handleRequestError(event) {
        const detail = event.detail || {};

        if (!this.isRouterRequest(detail)) return;

        if (detail.failed === true) return;

        this.emitNavigationError(detail);
    }


    emitNavigationError(detail) {
        const element = this.getTriggerElement(detail);

        emit(element, ROUTER_EVENTS.NAVIGATION_ERROR, {
            element,
            xhr: detail.xhr,
            status: detail.xhr?.status,
            error: detail.error,
            failed: detail.failed,
        });
    }


    handlePushedIntoHistory(event) {
        this.refreshActiveLinks();

        emit(document, ROUTER_EVENTS.LOCATION_CHANGE, {
            url: window.location.href,
            source: "htmx",
            detail: event.detail,
        });
    }


    handlePopState() {
        this.refreshActiveLinks();

        emit(document, ROUTER_EVENTS.LOCATION_CHANGE, {
            url: window.location.href,
            source: "popstate",
        });
    }


    /* ---------------------------------------------------------------------- */
    /* Dynamic DOM                                                            */
    /* ---------------------------------------------------------------------- */

    observeDOM() {
        if (this.observer) return;

        this.observer = new MutationObserver(mutations => {
            for (const mutation of mutations) {
                for (const node of mutation.addedNodes) {
                    if (node.nodeType !== Node.ELEMENT_NODE) continue;

                    if (node.matches?.("spice-app, spice-nav, spice-boost, [spice-boost]")) {
                        this.processBoostContainer(node);
                    }

                    node.querySelectorAll?.("spice-app, spice-nav, spice-boost, [spice-boost]").forEach(container => {
                        this.processBoostContainer(container);
                    });

                    if (node.matches?.("a[href]")) {
                        if (shouldEnhanceAnchor(node)) {
                            node.dataset.spiceNavigation = "true";
                            node.dataset.spiceLink = "true";
                        }
                    }

                    node.querySelectorAll?.("a[href]").forEach(anchor => {
                        if (shouldEnhanceAnchor(anchor)) {
                            anchor.dataset.spiceNavigation = "true";
                            anchor.dataset.spiceLink = "true";
                        }
                    });
                }
            }
        });

        this.observer.observe(document.body, {
            childList: true,
            subtree: true,
        });
    }
}


/* -------------------------------------------------------------------------- */
/* Module Auto-Initialization                                                 */
/* -------------------------------------------------------------------------- */

let globalRouter = null;

export function initSpiceRouter(options = {}) {
    if (globalRouter && globalRouter.started) {
        return globalRouter;
    }

    globalRouter = new SpiceRouter(options);
    globalRouter.start();

    return globalRouter;
}

// Automatically start when the module is imported and DOM is ready
if (typeof window !== "undefined") {
    window.SpiceRouter = SpiceRouter;

    if (typeof document !== "undefined") {
        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", () => {
                window.spiceRouter = initSpiceRouter();
            });
        } else {
            window.spiceRouter = initSpiceRouter();
        }
    }
}